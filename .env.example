LLM_PROVIDER=huggingface
HF_TOKEN=paste-your-huggingface-token-here
# Optional: these defaults use the lightweight SmolLM2 1.7B instruct model.
# SCREEN_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
# DRAFT_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
# For Gemini, use the current model name instead of the retired gemini-2.0-flash.
# SCREEN_MODEL=gemini-3.6-flash
# DRAFT_MODEL=gemini-3.6-flash

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=your-verified-sender@example.com
MAIL_TO=your-recipient@example.com